# Copy this file to .env and replace the session secret before starting.

# MongoDB standalone server (Atlas and replica sets are also supported).
MONGODB_URI=mongodb://127.0.0.1:27017/polling_software
MONGODB_DATABASE=polling_software

# Generate a unique secret, for example: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters-long

# Server
PORT=3000
NODE_ENV=development
DEBUG_REQUESTS=false

# Election and generated-order metadata
DISTRICT_NAME=Kakinada
ORDER_DATE=
ORDER_PLACE=Kakinada
ELECTION_YEAR=2026
TRAINING_DATE=
TRAINING_TIME_FROM=
TRAINING_TIME_TO=
TRAINING_VENUE=
TRAINING_MANDAL=
POLLING_DATE_TIME=
DISTRIBUTION_CENTER=
DISTRIBUTION_REPORT_TIME=

# Optional SMS provider
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ROUTE=q

# Optional WhatsApp Cloud API provider
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
